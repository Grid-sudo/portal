# Telegram bot token from @BotFather. Required to run the bot.
BOT_TOKEN=
APP_MODE=DEMO

# Service dependencies (local-development values; use a unique password on VPS).
DATABASE_URL=postgresql+asyncpg://giftbot:giftbot@postgres:5432/giftbot
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change_this_local_password

# Monitoring controls.
SCAN_INTERVAL_SECONDS=60
LISTING_MAX_AGE_SECONDS=300
MIN_DISCOUNT_PERCENT=10
MIN_TRAIT_COMPARABLES=3
PORTALS_API_KEY=
PORTALS_MAX_PAGES=5
LOG_LEVEL=INFO
LOG_FILE=data/nft-monitor.log

# No marketplace credentials or undocumented endpoints are enabled by default.
